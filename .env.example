# ==========================================================
#  Configuración del bot Aternos 24/7
#  Copia este archivo a ".env" y rellena tus datos reales.
#  NUNCA subas el archivo ".env" a GitHub (ya está en .gitignore).
# ==========================================================

# --- Credenciales de tu cuenta de aternos.org ---
ATERNOS_USER=tu_usuario_de_aternos
ATERNOS_PASSWORD=tu_contraseña_de_aternos

# Nombre EXACTO del servidor tal como aparece en aternos.org,
# o su índice numérico (0 = primer servidor de la lista).
ATERNOS_SERVER=0

# --- Datos del servidor (para el bot AFK de Minecraft) ---
SERVER_HOST=realityapp.aternos.me
SERVER_PORT=40706

# Versión de Minecraft que corre tu PaperMC (ej. 1.21.4).
# Usa "auto" para que mineflayer la detecte automáticamente.
# OJO: "26.2 (71)" NO es una versión válida de Minecraft; pon la
# versión real de MC (1.21.x, 1.20.x, etc.) o deja "auto".
MC_VERSION=auto

# Nombre con el que el bot se conecta al servidor.
BOT_USERNAME=AFKBot

# Modo de movimiento del bot AFK:
#   off = modo ESTABLE (por defecto). El bot NO se mueve; solo se queda
#         conectado. Es lo fiable para versiones nuevas de Minecraft (ej. 26.2)
#         que rechazan el movimiento con "Invalid move player packet received".
#   on  = el bot camina por el mapa, lucha contra mobs, huye con poca vida y
#         recoge/equipa armas. Úsalo SOLO en versiones compatibles (1.20.x/1.21.x).
MOVEMENT=off

# --- Solo aplican en modo activo (MOVEMENT=on) ---
# Corazones*2 por debajo de los cuales el bot HUYE (20 = vida llena, 8 = 4 corazones).
FLEE_HEALTH=8
# Radio (bloques) para detectar mobs enemigos y objetos en el suelo.
DETECT_RANGE=16
# Radio (bloques) en el que el bot pasea cuando no hay peligro.
ROAM_RADIUS=16

# --- Comportamiento ---
# Cada cuántos segundos se revisa el estado del servidor en Aternos.
CHECK_INTERVAL=60

# Cada cuántos segundos el bot AFK hace un micro-movimiento.
AFK_INTERVAL=30

# Segundos de espera antes de reconectar el bot AFK si se cae.
RECONNECT_DELAY=15

# --- Servidor web (panel de control + /health para UptimeRobot) ---
# En Render este puerto lo asigna la plataforma automáticamente (variable PORT).
PORT=8080

# Contraseña del panel de control web. Si la defines, el panel pedirá esta clave
# para ver/controlar el bot. Si la dejas vacía, el panel queda ABIERTO (sin clave).
# ¡Ponle una contraseña fuerte! (el panel es accesible desde la URL pública de Render)
PANEL_TOKEN=
